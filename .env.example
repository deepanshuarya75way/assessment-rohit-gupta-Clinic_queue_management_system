# App
NODE_ENV=development
SERVER_PORT=5000
CLIENT_PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cqms
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=change-this-to-a-random-secret-key
JWT_EXPIRES_IN=24h

# WhatsApp Cloud API (optional - leave blank to disable)
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# Email (Nodemailer) - optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@clinic.com

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
